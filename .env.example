[TEMPLATE]
# Copy this file to apps/api/.env and adjust as needed.

# PostgreSQL connection string
DATABASE_URL=postgresql://expense:expense@localhost:5433/expense

# Port the API listens on
PORT=3000

# Application timezone used for Day/Week/Month aggregation (server-side)
APP_TIMEZONE=Asia/Jakarta

# HMAC secret for PIN lookup + token signing. Generate ONCE and keep secret:
#   openssl rand -hex 32
# Rotating it invalidates all sessions and makes existing PIN lookups
# unresolvable (all users must re-confirm their PIN).
APP_JWT_SECRET=replace-with-openssl-rand-hex-32

# One-off migration only (prisma/adopt.ts): the PIN that will own the
# legacy rows. Do NOT commit the real value anywhere.
# ADOPT_PIN=

# Dev-only seed (prisma/seed.ts): PIN of the dev user to seed data for.
# SEED_PIN=

# --- Production web only (docker-compose.prod.yml) ---------------------------
# Public domain Caddy serves with automatic HTTPS. This one belongs in the
# ROOT .env (compose interpolation), not apps/api/.env. The domain's A record
# must point at the VPS and ports 80/443 must be open. Without it the PWA is
# not installable from a phone (service workers need a secure context).
CADDY_DOMAIN=expense.example.com
