generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// HMAC(APP_JWT_SECRET, "pin-lookup" || pin) — used to FIND the user, never the PIN itself.
  pinLookup String   @unique @map("pin_lookup")
  /// scrypt hash — used to VERIFY the PIN. The raw PIN is never stored.
  pinHash   String   @map("pin_hash")
  /// Soft-delete flag. Deactivation tombstones pinLookup to "inactive:<id>"
  /// (freeing the PIN for reuse) but keeps the row so old expenses stay
  /// attached to the old identity. Default true = single non-breaking push.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  expenses Expense[]
  budgets  Budget[]

  @@map("users")
}

model Expense {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount     BigInt   @db.BigInt
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Owned by exactly one PIN identity. Migrations are two-push:
  /// push-1 adds this column optional, legacy rows are adopted
  /// (prisma/adopt.ts), push-2 makes it required.
  userId String  @map("user_id") @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("expenses")
}

/// Budget type: "full" = one cap for the whole range; "daily" = cap per day.
enum BudgetType {
  full
  daily
}

/// Budget (feature plan §1): ONE active budget per user; deactivating an old
/// budget IS the history (no soft-delete flag, no row deletion — "Pakai lagi"
/// reads past budgets to prefill the create form). Spent is NOT stored: it is
/// recomputed live from expenses inside the budget range so edited expenses
/// always stay consistent.
model Budget {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Scope per PIN identity, same pattern as Expense.userId.
  userId    String     @map("user_id") @db.Uuid
  type      BudgetType
  /// Total cap (full) / per-day cap (daily). Reuses amountSchema bounds.
  amount    BigInt     @db.BigInt
  /// Inclusive calendar dates (no time-of-day component).
  startDate DateTime   @map("start_date") @db.Date
  endDate   DateTime   @map("end_date") @db.Date
  /// Exactly one per user at any time (enforced in a transaction on create —
  /// plan §1: no partial unique index needed).
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, startDate])
  @@map("budgets")
}
